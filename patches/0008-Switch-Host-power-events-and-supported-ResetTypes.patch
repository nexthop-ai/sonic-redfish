  redfish-core/include/event_service_manager.hpp |  7 ++++++
  redfish-core/lib/event_service.hpp             |  9 ++++----
  redfish-core/lib/systems.hpp                   | 61 ++++++++++++++++++-----------------------
  redfish-core/src/utils/dbus_utils.cpp          |  9 ++++++--
  5 files changed, 54 insertions(+), 33 deletions(-)

